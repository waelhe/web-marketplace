# Copy to .env.local and fill in. Never commit real secrets.
# Dev values live only in the local .env.local (see README + backend runbook).
# Dev backend since 2026-09-22: the backend team's shared staging service
# (docs/frontend-dev-oauth-setup.md in app-java-v3) — never a local backend
# checkout, never production. The staging client secret comes from the
# backend team (shareable, dev-only); production lives in Railway only.
BETTER_AUTH_SECRET=CHANGE_ME_32_PLUS_CHARS
BETTER_AUTH_URL=http://localhost:3000
BACKEND_URL=https://app-java-v3-staging-staging.up.railway.app
OAUTH_CLIENT_ID=marketplace-web-staging
OAUTH_CLIENT_SECRET=CHANGE_ME
